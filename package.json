{
  "name": "tut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tut": "./src/main.ts"
  },
  "scripts": {
    "build:bin": "bun build --compile ./src/main.ts --outfile ./dist/tut-aarch64-darwin",
    "build:release": "bun run build:bin && gzip -9 -c ./dist/tut-aarch64-darwin > ./dist/tut-aarch64-darwin.gz",
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/react": "^19.2.15",
    "@types/react-reconciler": "^0.33.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.10",
  "dependencies": {
    "@opentui/core": "^0.1.88",
    "@opentui/react": "^0.1.88",
    "react": "^19.2.4"
  }
}
